{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "TradingPets": {
    "InitialTraderCash": 1000,
    "DefaultSupplyPerBreed": 3,
    "ValuationTickSeconds": 60,
    "AgeYearsEveryMinute": 0.5,
    "TraderSeedCount": 0,
    "AllowAnyAuthenticatedUserForAllTraders": false
  },
  "Messaging": {
    "Transport": "AzureServiceBus",
    "TopicName": "trading.lifecycle",
    "SubscriptionName": "market-service.relay-realtime"
  },
  "AllowedHosts": "*"
}
